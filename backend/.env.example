# S3 bucket for catalog uploads
S3_BUCKET=cleandata-uploads

# Email to notify when a catalog is uploaded
NOTIFY_EMAIL=salt@usepepper.com

# SES verified sender address
SES_SENDER=noreply@cleandata.com

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# AWS credentials — uses boto3 credential chain
# (env vars, ~/.aws/credentials, IAM role, etc.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
